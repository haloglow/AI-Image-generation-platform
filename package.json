{
  "name": "kiro-image-chat-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Electron + Vue 图像工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "vite build"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "vite": "^6.4.2",
    "wait-on": "^9.0.5"
  }
}
